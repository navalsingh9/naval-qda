{
  "name": "naval-qda",
  "version": "0.4.3",
  "description": "NAVAL-QDA desktop application for qualitative data analysis",
  "author": {
    "name": "NAVAL-QDA",
    "email": "support@navalqda.example"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build",
    "build": "npm run build:frontend && electron-builder",
    "package:win": "npm run build:frontend && electron-builder --win",
    "package:mac": "npm run build:frontend && electron-builder --mac",
    "package:linux": "npm run build:frontend && electron-builder --linux",
    "release:win": "npm run build:frontend && electron-builder --win --publish never",
    "release:mac": "npm run build:frontend && electron-builder --mac --publish never",
    "release:linux": "npm run build:frontend && electron-builder --linux --publish never",
    "test": "node --test \"backend/**/*.test.js\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "nodejs-whisper": "^0.3.0",
    "pdf-parse": "^2.4.5",
    "yauzl": "^3.4.0"
  }
}
